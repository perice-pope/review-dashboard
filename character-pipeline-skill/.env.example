# Character Pipeline — copy to `.env` and fill in YOUR OWN keys.
# This skill reads keys ONLY from the environment and never stores, prints,
# logs, or transmits them anywhere except Replicate / Runway themselves.
#
#   cp .env.example .env   &&   set -a && source .env && set +a
#
# `.env` is gitignored — never commit your keys.

# Replicate — used for training (Stage 1) and stills (Stage 2).
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Runway — used for animation (Stage 3).
# Get one in the Runway developer portal: https://dev.runwayml.com
RUNWAY_API_KEY=
